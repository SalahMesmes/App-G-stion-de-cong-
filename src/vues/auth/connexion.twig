{% extends "base.twig" %}

{% block titre %}Connexion{% endblock %}

{% block contenu %}
<style>
    .login-container {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .login-card {
        width: 100%;
        max-width: 450px;
    }
    .login-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
</style>
<div class="login-container">
    <div class="login-card">
        <div class="card shadow">
            <div class="card-header text-center" style="background-color: #ffc107; color: #000;">
                <h4><i class="bi bi-box-arrow-in-right"></i> Connexion</h4>
            </div>
            <div class="card-body">
                {% if erreur %}
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> {{ erreur }}
                </div>
                {% endif %}

                <form method="POST" action="index.php?route=auth/connexion">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label for="mot_de_passe" class="form-label">Mot de passe</label>
                        <input type="password" class="form-control" id="mot_de_passe" name="mot_de_passe" required>
                    </div>
                    <div class="d-flex justify-content-center">
                        <button type="submit" class="btn login-button" style="background-color: #ffc107; border-color: #ffc107; color: #000; font-weight: 500;">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-muted text-center">
            </div>
        </div>
    </div>
</div>
{% endblock %}
