{% extends "base.twig" %}

{% block titre %}Détails de la demande{% endblock %}

{% block contenu %}
<h1 class="mb-4">
    <i class="bi bi-eye"></i> Détails de la demande
</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>Informations de la demande</h5>
                <span class="badge bg-{{ demande.statut == 'ACCEPTE' ? 'success' : (demande.statut == 'REFUSE' ? 'danger' : (demande.statut == 'EN_ATTENTE' ? 'warning' : 'secondary')) }}">
                    {{ demande.statut }}
                </span>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Type de congé</dt>
                    <dd class="col-sm-8">{{ demande.type_conge_libelle }}</dd>

                    <dt class="col-sm-4">Employé</dt>
                    <dd class="col-sm-8">{{ demande.utilisateur_prenom }} {{ demande.utilisateur_nom }}</dd>

                    <dt class="col-sm-4">Période</dt>
                    <dd class="col-sm-8">
                        Du {{ demande.date_debut|date('d/m/Y') }} au {{ demande.date_fin|date('d/m/Y') }}
                        {% if demande.demi_journee != 'NONE' %}
                            <span class="badge bg-info">{{ demande.demi_journee }}</span>
                        {% endif %}
                    </dd>

                    <dt class="col-sm-4">Jours ouvrés</dt>
                    <dd class="col-sm-8"><strong>{{ demande.jours_ouvres }}</strong></dd>

                    {% if demande.motif %}
                    <dt class="col-sm-4">Motif</dt>
                    <dd class="col-sm-8">{{ demande.motif }}</dd>
                    {% endif %}

                    {% if demande.commentaire %}
                    <dt class="col-sm-4">Commentaire</dt>
                    <dd class="col-sm-8">{{ demande.commentaire }}</dd>
                    {% endif %}

                    {% if demande.justificatif %}
                    <dt class="col-sm-4">Justificatif</dt>
                    <dd class="col-sm-8">
                        <a href="uploads/{{ demande.justificatif }}" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-file-earmark"></i> Voir le justificatif
                        </a>
                    </dd>
                    {% endif %}

                    <dt class="col-sm-4">Date de création</dt>
                    <dd class="col-sm-8">{{ demande.created_at|date('d/m/Y à H:i') }}</dd>

                    {% if demande.decision_par %}
                    <dt class="col-sm-4">Décision par</dt>
                    <dd class="col-sm-8">{{ demande.decision_prenom }} {{ demande.decision_nom }}</dd>

                    <dt class="col-sm-4">Date de décision</dt>
                    <dd class="col-sm-8">{{ demande.decision_date|date('d/m/Y à H:i') }}</dd>

                    {% if demande.commentaire_decision %}
                    <dt class="col-sm-4">Commentaire de décision</dt>
                    <dd class="col-sm-8">{{ demande.commentaire_decision }}</dd>
                    {% endif %}
                    {% endif %}
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="index.php?route=conge/mes-demandes" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>
{% endblock %}
