{% extends "base.twig" %}

{% block titre %}Gestion des employés{% endblock %}

{% block contenu %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-people"></i> Gestion des employés</h1>
    <a href="index.php?route=manager/employes/creer" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvel employé
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Service</th>
                        <th>Poste</th>
                        <th>Date d'embauche</th>
                        <th>Rôle</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for employe in employes %}
                    <tr>
                        <td>{{ employe.nom }}</td>
                        <td>{{ employe.prenom }}</td>
                        <td>{{ employe.email }}</td>
                        <td>{{ employe.service }}</td>
                        <td>{{ employe.poste }}</td>
                        <td>{{ employe.date_embauche|date('d/m/Y') }}</td>
                        <td>
                            <span class="badge bg-{{ employe.role == 'MANAGER' ? 'primary' : 'secondary' }}">
                                {{ employe.role }}
                            </span>
                        </td>
                        <td>
                            <a href="index.php?route=manager/employes/modifier&id={{ employe.id }}" 
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            {% if employe.id != utilisateur.id %}
                            <form method="POST" action="index.php?route=manager/employes/supprimer" 
                                  class="d-inline" 
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet employé ?');">
                                <input type="hidden" name="id" value="{{ employe.id }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
