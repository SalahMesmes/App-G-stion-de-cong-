{% extends "base.twig" %}

{% block titre %}Gestion des types de congés{% endblock %}

{% block contenu %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-tags"></i> Gestion des types de congés</h1>
    <a href="index.php?route=manager/types-conges/creer" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouveau type
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Libellé</th>
                        <th>Justificatif obligatoire</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for type in types %}
                    <tr>
                        <td><strong>{{ type.code }}</strong></td>
                        <td>{{ type.libelle }}</td>
                        <td>
                            {% if type.justificatif_obligatoire %}
                                <span class="badge bg-warning">Oui</span>
                            {% else %}
                                <span class="badge bg-secondary">Non</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if type.actif %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-danger">Inactif</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="index.php?route=manager/types-conges/modifier&id={{ type.id }}" 
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="POST" action="index.php?route=manager/types-conges/supprimer" 
                                  class="d-inline" 
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce type de congé ?');">
                                <input type="hidden" name="id" value="{{ type.id }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
