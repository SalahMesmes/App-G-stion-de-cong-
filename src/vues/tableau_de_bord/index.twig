{% extends "base.twig" %}

{% block titre %}Tableau de bord{% endblock %}

{% block contenu %}
<h1 class="mb-4">
    <i class="bi bi-house"></i> Tableau de bord
</h1>

<div class="row mb-4 justify-content-center">
    <div class="col-md-3">
        <div class="card" style="background-color: #ffb300; color: #000;">
            <div class="card-body">
                <h5 class="card-title">En attente</h5>
                <h2>{{ stats.en_attente }}</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card" style="background-color: #6c757d; color: #fff;">
            <div class="card-body">
                <h5 class="card-title">Acceptées</h5>
                <h2>{{ stats.acceptees }}</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card" style="background-color: #495057; color: #fff;">
            <div class="card-body">
                <h5 class="card-title">Refusées</h5>
                <h2>{{ stats.refusees }}</h2>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5><i class="bi bi-clock-history"></i> Dernières demandes</h5>
                <a href="index.php?route=conge/mes-demandes" class="btn btn-sm btn-outline-primary">
                    Voir tout
                </a>
            </div>
            <div class="card-body">
                {% if demandesRecentes %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Période</th>
                                <th>Jours</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for demande in demandesRecentes %}
                            <tr>
                                <td>{{ demande.type_conge_libelle }}</td>
                                <td>
                                    {{ demande.date_debut|date('d/m/Y') }}
                                    {% if demande.date_fin != demande.date_debut %}
                                        - {{ demande.date_fin|date('d/m/Y') }}
                                    {% endif %}
                                    {% if demande.demi_journee != 'NONE' %}
                                        <span class="badge bg-info">{{ demande.demi_journee }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ demande.jours_ouvres }}</td>
                                <td>
                                    {% if demande.statut == 'EN_ATTENTE' %}
                                        <span class="badge bg-warning">En attente</span>
                                    {% elseif demande.statut == 'ACCEPTE' %}
                                        <span class="badge bg-success">Accepté</span>
                                    {% elseif demande.statut == 'REFUSE' %}
                                        <span class="badge bg-danger">Refusé</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Annulé</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="index.php?route=conge/voir&id={{ demande.id }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <p class="text-muted text-center">Aucune demande pour le moment.</p>
                <div class="text-center">
                    <a href="index.php?route=conge/creer" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Créer une demande
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
